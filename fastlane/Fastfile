default_platform(:ios)

platform :ios do
  desc "Build Release archive and upload to TestFlight"
  lane :beta do
    build_app(
      workspace: "ios/ZingoDelegator.xcworkspace",
      scheme: "ZingoDelegator",
      configuration: "Release",
      output_directory: "build"
    )
    sh("xcodebuild -exportArchive -archivePath '#{lane_context[SharedValues::XCODEBUILD_ARCHIVE]}' -exportOptionsPlist '#{File.expand_path('ExportOptions.plist', __dir__)}' -exportPath '#{File.expand_path('../build', __dir__)}' -allowProvisioningUpdates")
  end

  desc "CI: archive with automatic signing through an App Store Connect API key, then upload to TestFlight"
  lane :release do
    setup_ci

    import_certificate(
      certificate_path: ENV.fetch("IOS_DIST_CERT_PATH"),
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID")
    key_path = File.expand_path(ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"))

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    marketing_version = ENV.fetch("MARKETING_VERSION")
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "org.ZingoLabs.ZingoDelegator",
      version: marketing_version,
      initial_build_number: 0
    ) + 1
    UI.important("Archiving #{marketing_version} (#{build_number})")

    auth = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"
    versions = "MARKETING_VERSION=#{marketing_version} CURRENT_PROJECT_VERSION=#{build_number}"

    build_app(
      workspace: "ios/ZingoDelegator.xcworkspace",
      scheme: "ZingoDelegator",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "ZingoDelegator",
      xcargs: "#{auth} #{versions}",
      export_options: {
        signingStyle: "automatic",
        teamID: "788KRST4S8",
        uploadSymbols: true
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ZingoDelegator.ipa",
      distribute_external: true,
      groups: ["Apr 2026 - CrossLink Workshop"],
      changelog: ENV.fetch("GITHUB_REF_NAME", marketing_version)
    )
  end
end

platform :android do
  desc "CI: build the release bundle with a version code above every Play track, then upload it to open testing"
  lane :release do
    package_name = "org.ZingoLabs.ZingoDelegator"
    json_key = File.expand_path(ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON_PATH"))
    version_name = ENV.fetch("MARKETING_VERSION")

    codes = %w[production beta alpha internal].flat_map do |track|
      google_play_track_version_codes(package_name: package_name, track: track, json_key: json_key)
    rescue StandardError => e
      UI.error("#{track}: #{e.message}")
      []
    end
    UI.user_error!("No version code could be read from any Google Play track") if codes.empty?
    version_code = codes.max + 1
    UI.important("Building #{version_name} (#{version_code})")

    gradle(
      project_dir: "android",
      tasks: ["bundleRelease", "assembleRelease"],
      properties: { "appVersionName" => version_name, "appVersionCode" => version_code }
    )

    upload_to_play_store(
      package_name: package_name,
      track: "beta",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: json_key,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true
    )
  end
end
