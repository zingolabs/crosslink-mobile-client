default_platform(:ios)

platform :ios do
  desc "Build Release archive and upload to TestFlight"
  lane :beta do
    build_app(
      workspace: "ios/ZingoDelegator.xcworkspace",
      scheme: "ZingoDelegator",
      configuration: "Release",
      output_directory: "build"
    )
    sh("xcodebuild -exportArchive -archivePath '#{lane_context[SharedValues::XCODEBUILD_ARCHIVE]}' -exportOptionsPlist 'fastlane/ExportOptions.plist' -exportPath 'build' -allowProvisioningUpdates")
  end
end
