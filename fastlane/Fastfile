default_platform(:ios)

platform :ios do
  desc "Build Release archive and upload to TestFlight"
  lane :beta do
    build_app(
      workspace: "ios/ZingoDelegator.xcworkspace",
      scheme: "ZingoDelegator",
      configuration: "Release",
      output_directory: "build"
    )
    sh("xcodebuild -exportArchive -archivePath '#{lane_context[SharedValues::XCODEBUILD_ARCHIVE]}' -exportOptionsPlist '#{File.expand_path('ExportOptions.plist', __dir__)}' -exportPath '#{File.expand_path('../build', __dir__)}' -allowProvisioningUpdates")
  end

  desc "CI: archive with the stored distribution certificate and App Store profiles, then upload to TestFlight"
  lane :release do
    setup_ci

    import_certificate(
      certificate_path: ENV.fetch("IOS_DIST_CERT_PATH"),
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"))
    )

    team_id = "788KRST4S8"
    bundle_ids = {
      "ZingoDelegator" => "org.ZingoLabs.ZingoDelegator",
      "StakingDayWidgetExtension" => "org.ZingoLabs.ZingoDelegator.StakingDayWidget"
    }
    profile_names = bundle_ids.to_h do |target, bundle_id|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: bundle_id,
        team_id: team_id
      )
      profile_name = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ios/ZingoDelegator.xcodeproj",
        team_id: team_id,
        targets: [target],
        build_configurations: ["Release"],
        code_sign_identity: "iPhone Distribution",
        profile_name: profile_name
      )
      [bundle_id, profile_name]
    end

    marketing_version = ENV.fetch("MARKETING_VERSION")
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "org.ZingoLabs.ZingoDelegator",
      version: marketing_version,
      initial_build_number: 0
    ) + 1
    UI.important("Archiving #{marketing_version} (#{build_number})")

    build_app(
      workspace: "ios/ZingoDelegator.xcworkspace",
      scheme: "ZingoDelegator",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "ZingoDelegator",
      xcargs: "MARKETING_VERSION=#{marketing_version} CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: profile_names,
        uploadSymbols: true
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ZingoDelegator.ipa",
      distribute_external: true,
      groups: ["Apr 2026 - CrossLink Workshop"],
      changelog: "release-#{marketing_version}"
    )
  end
  desc "CI: send an uploaded TestFlight build to the external tester group"
  lane :distribute do
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID")
    key_path = File.expand_path(ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"))

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "org.ZingoLabs.ZingoDelegator",
      app_platform: "ios",
      app_version: ENV.fetch("MARKETING_VERSION"),
      build_number: ENV.fetch("BUILD_NUMBER"),
      distribute_only: true,
      distribute_external: true,
      groups: ["Apr 2026 - CrossLink Workshop"]
    )
  end
end

platform :android do
  desc "CI: build the release bundle with a version code above every Play track, then upload it to open testing"
  lane :release do
    package_name = "org.ZingoLabs.ZingoDelegator"
    json_key = File.expand_path(ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON_PATH"))
    version_name = ENV.fetch("MARKETING_VERSION")

    codes = %w[production beta alpha internal].flat_map do |track|
      google_play_track_version_codes(package_name: package_name, track: track, json_key: json_key)
    rescue StandardError => e
      UI.error("#{track}: #{e.message}")
      []
    end
    UI.user_error!("No version code could be read from any Google Play track") if codes.empty?
    version_code = codes.max + 1
    UI.important("Building #{version_name} (#{version_code})")

    gradle(
      project_dir: "android",
      tasks: ["bundleRelease", "assembleRelease"],
      properties: { "appVersionName" => version_name, "appVersionCode" => version_code }
    )

    upload_to_play_store(
      package_name: package_name,
      track: "beta",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: json_key,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true
    )
  end
end
