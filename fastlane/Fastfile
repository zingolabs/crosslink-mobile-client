default_platform(:ios)

platform :ios do
  desc "Build Release archive and upload to TestFlight"
  lane :beta do
    build_app(
      workspace: "ios/ZingoDelegator.xcworkspace",
      scheme: "ZingoDelegator",
      configuration: "Release",
      output_directory: "build"
    )
    sh("xcodebuild -exportArchive -archivePath '#{lane_context[SharedValues::XCODEBUILD_ARCHIVE]}' -exportOptionsPlist '#{File.expand_path('ExportOptions.plist', __dir__)}' -exportPath '#{File.expand_path('../build', __dir__)}' -allowProvisioningUpdates")
  end
end
