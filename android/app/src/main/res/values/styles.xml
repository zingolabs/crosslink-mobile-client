<resources>

    <!-- Base application theme. Dark: native dialogs (Alert.alert) and the
         window background follow the app's dark UI. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="alertDialogTheme">@style/AppAlertDialog</item>
    </style>

    <!-- Native alert dialogs: panel surface, card radius, accent buttons. -->
    <style name="AppAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#1C78D2</item>
        <item name="android:windowBackground">@drawable/alert_dialog_bg</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

</resources>
