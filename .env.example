# Baked into release bundles at build time by scripts/build-env.cjs. Copy to .env.
DELEGATOR_REPORT_URL=https://delegator-report.dariovp01.workers.dev
DELEGATOR_REPORT_TOKEN=
# Dev bundles post to the local Worker. Set to prod to send a dev bundle's reports to production; they arrive marked [DEV].
DELEGATOR_REPORT_TARGET=
# Set to 1 only for a verification build. Enables the delegator://crash-test deep link.
DELEGATOR_CRASH_TEST=0
